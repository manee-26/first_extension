{
  "manifest_version": 3,
  "name": "Planova",
  "version": "1.0.0",
  "description": "Plan. Focus. Achieve. — track your daily tasks with Planova.",
  "action": {
    "default_popup": "index.html",
    "default_title": "Planova",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "storage"
  ]
}
